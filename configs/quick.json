{
  "name": "quick_smoke",
  "seed": 1,
  "output_dir": "outputs",
  "scm_kind": "classical",
  "graph_type": "chain",
  "n_observed": 3,
  "n_latent": 0,
  "max_lag": 2,
  "length": 200,
  "edge_prob": 0.3,
  "nonlinear": "linear",
  "noise_kind": "gaussian",
  "noise_scale": 1.0,
  "feedback_strength": 0.2,
  "weight_scale": 0.5,
  "fp_tol": 1e-5,
  "fp_max_iter": 2000,
  "damping": 0.9,
  "burn_in": 30,
  "algorithms": ["pcmci", "granger"],
  "pcmci_alpha": 0.1,
  "pc_alpha": 0.1,
  "use_cycle_postprocess": false,
  "save_plots": false
}
